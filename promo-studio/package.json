{
  "name": "ironhand-promo-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns real UGC footage into branded promo videos for Ironhand Studio.",
  "scripts": {
    "new": "tsx scripts/cli.ts new",
    "prep": "tsx scripts/cli.ts prep",
    "transcribe": "tsx scripts/cli.ts transcribe",
    "props": "tsx scripts/cli.ts props",
    "preview": "tsx scripts/cli.ts preview",
    "render": "tsx scripts/cli.ts render",
    "make": "tsx scripts/cli.ts make",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/*.test.ts src/**/*.test.ts && python3 -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/layout-utils": "4.0.537",
    "@remotion/zod-types": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
