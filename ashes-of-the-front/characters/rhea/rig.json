    {"name": "foot_l", "parent": "shin_l", "transform": {"x": 0, "y": 190}, "length": 60, "tags": []},
    {"name": "thigh_r", "parent": "root", "transform": {"x": 60, "y": 0}, "length": 200, "tags": ["ik_chain"]},
    {"name": "shin_r", "parent": "thigh_r", "transform": {"x": 0, "y": 200}, "length": 190, "tags": ["ik_chain"]},
    {"name": "foot_r", "parent": "shin_r", "transform": {"x": 0, "y": 190}, "length": 60, "tags": []},
    {"name": "ik_hand_l", "parent": "root", "transform": {"x": -200, "y": -80}, "length": 0, "tags": ["ik_target"]},
