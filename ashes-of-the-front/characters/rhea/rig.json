    {"name": "upper_arm_r", "parent": "chest", "transform": {"x": 110, "y": -110}, "length": 150, "tags": ["ik_chain"]},
    {"name": "forearm_r", "parent": "upper_arm_r", "transform": {"x": 0, "y": 150}, "length": 130, "tags": ["ik_chain"]},
    {"name": "hand_r", "parent": "forearm_r", "transform": {"x": 0, "y": 130}, "length": 40, "tags": []},
    {"name": "thigh_l", "parent": "root", "transform": {"x": -60, "y": 0}, "length": 200, "tags": ["ik_chain"]},
