{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Schema v2 (Phase 2). v1 had no canvas, no layer pivots and inline expression/mouth maps; those now live in face.json and rig.json.",
  "title": "Ashes of the Front asset manifest",
  "description": "One asset.json per character, environment, prop or effect. Pixel coordinates are measured from the canvas top-left, y down.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "name", "version", "status", "description", "layers"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["character", "environment", "prop", "effect"] },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "review", "approved"] },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "character": { "$ref": "#/$defs/character" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "character" } }, "required": ["type"] },
      "then": { "required": ["character"] },
      "else": { "not": { "required": ["character"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40 },
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "layer": {
      "description": "One PNG layer. Its file must be layers/<name>.png. The pivot is the joint the layer rotates around, in canvas pixels.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "z", "pivot"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "file": { "type": "string", "minLength": 1 },
        "z": { "type": "integer" },
        "pivot": { "$ref": "#/$defs/point" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "canvas"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "canvas": { "$ref": "#/$defs/canvas" }
      }
    },
    "canvas": {
      "description": "Every layer of a character is exactly this size. root is the character's origin (the hip joint) and the origin of rig coordinates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "root"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "root": { "$ref": "#/$defs/point" }
      }
    },
    "identity": {
      "description": "Fixed appearance facts. Changing these is a version bump that needs approval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "role"],
      "properties": {
        "age": { "type": "integer", "minimum": 0, "maximum": 120 },
        "gender": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "build": { "type": "string" },
        "hair": { "type": "string" },
        "distinguishing_features": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
