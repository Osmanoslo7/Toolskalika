{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ashes of the Front asset manifest",
  "description": "One asset.json per character, environment, prop or effect. Times and sizes are in pixels and seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "version", "status", "description", "layers"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "type": { "enum": ["character", "environment", "prop", "effect"] },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "review", "approved"] },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "character": { "$ref": "#/$defs/character" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "character" } }, "required": ["type"] },
      "then": { "required": ["character"] },
      "else": { "not": { "required": ["character"] } }
    }
  ],
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "z"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "z": { "type": "integer" },
        "pivot": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "expressions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z_]+$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "mouth_shapes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/viseme" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "rig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "identity": {
      "description": "Fixed appearance facts. Changing these is a version bump that needs approval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "role"],
      "properties": {
        "age": { "type": "integer", "minimum": 0, "maximum": 120 },
        "gender": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "build": { "type": "string" },
        "hair": { "type": "string" },
        "distinguishing_features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "viseme": {
      "description": "Mouth shapes (Preston Blair set). 'rest' is the closed/neutral mouth.",
      "enum": ["rest", "AI", "E", "O", "U", "etc", "FV", "L", "MBP", "WQ"]
    }
  }
}
