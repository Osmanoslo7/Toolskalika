# Copy to .env and fill in before running the server.

# Human name shown during the passkey ceremony. Only this person can ever
# register — the server refuses a second registration once one exists.
OWNER_NAME="Your Name"
OWNER_EMAIL="you@example.com"

# WebAuthn relying-party identity. RP_ID must be the bare domain (or
# "localhost" for local use) that the browser is pointed at when the
# Face ID / Touch ID / Windows Hello prompt happens.
RP_ID=localhost
RP_NAME=Toolskalika
ORIGIN=http://localhost:8000

# Random 32-byte key used to encrypt secrets at rest (e.g. any third-party
# API keys you store through the API). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOLSKALIKA_SECRET_KEY=

# SQLite by default; point elsewhere if you want.
DATABASE_URL=sqlite:///./toolskalika.db

# Optional: powers the writing/brainstorm/meme tools with real Claude
# output. Without it, tools fall back to local template generation.
ANTHROPIC_API_KEY=
